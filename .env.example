# Primary DB: Supabase session pooler (TLS) or a self-hosted PostgreSQL URL.
# DATABASE_URL takes precedence; leave blank to use LOCAL_DB_URL.
DATABASE_URL=
LOCAL_DB_URL=postgresql://homelab:password@localhost:5432/homelab
# public for existing Supabase tables; drophunter for the home-server schema.
DB_SCHEMA=drophunter

# Backup only; disabled in Actions until SUPABASE_BACKUP_ENABLED=true.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-key

ITAD_API_KEY=your-itad-api-key
DISCORD_BOT_TOKEN=your-discord-bot-token
OWNER_ID=your-discord-user-id

AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=
# Optional: AI_PROVIDER=omniroute. Base URL includes /v1.
OMNIROUTE_BASE_URL=https://your-router.example.com/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
OMNIROUTE_TIMEOUT_SECONDS=60

# Optional email alerts to each user's registered address.
RESEND_API_KEY=
EMAIL_FROM=DropHunter <alerts@your-verified-domain.example>

# Optional tracing for the conversational bot.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
