# Primary database (local Postgres, drophunter schema)
LOCAL_DB_URL=postgresql://homelab:password@localhost:5432/homelab

# Supabase — backup only (used by cron/supabase_backup.py every 3 days)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

ITAD_API_KEY=your-itad-api-key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=123456789012345678
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
AI_PROVIDER=groq
